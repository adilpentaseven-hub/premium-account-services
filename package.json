{
  "name": "premium-account-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "next start",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "migrate:create": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate:create",
    "migrate": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.72.0",
    "@payloadcms/next": "3.72.0",
    "@payloadcms/richtext-lexical": "3.72.0",
    "@payloadcms/storage-vercel-blob": "3.72.0",
    "cross-env": "7.0.3",
    "graphql": "16.8.1",
    "next": "15.4.11",
    "payload": "3.72.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3"
  },
  "engines": {
  "node": "22.x"
  }
