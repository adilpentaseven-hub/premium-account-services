# Copy these names into Vercel. Never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Use true only for the first database bootstrap/development phase.
# After migrations are established, change it to false.
PAYLOAD_DB_PUSH=true

# Added automatically after connecting Vercel Blob Storage.
BLOB_READ_WRITE_TOKEN=
